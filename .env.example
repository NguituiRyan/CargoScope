# ─────────────────────────────────────────────────────────────
# CargoScope — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# Only NEXT_PUBLIC_* values are exposed to the browser; everything
# else stays server-side (Server Actions, Route Handlers).
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle — direct Postgres connection (Supabase session/pooler string).
# Connects as the DB owner and BYPASSES RLS: used only for migrations and
# trusted server-side reads. Find it under Supabase → Project Settings →
# Database → Connection string (use the pooler URI for serverless).
DATABASE_URL=

# Anthropic — AI translation + assistant (server-side only)
ANTHROPIC_API_KEY=

# Resend — transactional email (server-side only)
RESEND_API_KEY=
RESEND_FROM_EMAIL="CargoScope <noreply@cargoscope.app>"

# Payments — subscriptions via Paddle (Merchant of Record). Sandbox to start.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Payments — buyer checkout via Flutterwave. Sandbox to start.
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# FX — USD→KES for landed-cost calculator (Open Exchange Rates, server-side only).
# When OPENEXCHANGERATES_APP_ID is set the live rate is fetched once daily and
# cached; otherwise the calculator uses FX_FALLBACK_USD_KES (defaults to 129).
OPENEXCHANGERATES_APP_ID=
FX_FALLBACK_USD_KES=129

# Sentry — error monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time source map upload (set in CI only; leave blank locally)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
